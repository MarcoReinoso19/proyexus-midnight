    "tokenColors": [
        //CUSTOMIZED
        {
            //OTHER
            "name": "Keyword, Storage",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
            ],
            "settings": {
                "foreground": "#EB6774"
            }
        },
        {
            //OTHER
            "name": "String Interpolation, Template String",
            "scope": [
                "source.python", "source.dart"
            ],
            "settings": {
                "foreground": "#BFF8DD"
            }
        },
        {
            //CLASS
            "name": "Class, Support",
            "scope": [
                "entity.name.type",
                "support.type",
                "support.class",
                "support.other.namespace.use.php",
                "meta.use.php",
                "support.other.namespace.php",
                "markup.changed.git_gutter",
                "support.type.sys-types",
            ],
            "settings": {
                "foreground": "#EAE666"
            }
        },
        {
            "name": "Entity Types",
            "scope": [
                "support.type"
            ],
            "settings": {
                "foreground": "#afafef"
            }
        },
        {
            //COMMENTS
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "italic",
                // "foreground": "#546656"
                "foreground": "#7e9183"
            }
        },
        {
            "name": "Docstring",
            "scope": [
                "punctuation.definition.string.begin",
                "punctuation.definition.string.end",
                "string.quoted.docstring"
            ],
            "settings": {
                "foreground": "#7E9183"
            }
        },
        {
            "name": "String, Symbols, Inherited Class, Markup Heading",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.other.key",
                "entity.other.inherited-class",
                "markup.heading",
                "markup.inserted.git_gutter",
                "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
            ],
            "settings": {
                "foreground": "#98c379"
            }
        },
        {
            //FUNCTION
            "name": "Function",
            "scope": [
                "entity.name.function",
                "meta.member.access",
                "variable.function",
                "support.function",
                "keyword.other.special-method",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#38d68c"
                // "foreground": "#67BFEB"
            }
        },
        {
            //FUNCTION ARGUMENTS
            "name": "Function Argument, Tag Attribute, Embedded",
            "scope": [
                "variable.parameter",
                "keyword.other.unit",
                "keyword.other"
            ],
            "settings": {
                // "foreground": "#ffab66"
                "foreground": "#7f86e5"
            }
        },

        {
            "name": "Operator, Misc",
            "scope": [
                "constant.other.color",
                "punctuation",
                "meta.tag",
                "punctuation.definition.tag",
                "punctuation.separator.inheritance.php",
