        "enumMember": {
            "foreground": "#56b6c2"
        },
        "macro": {
            "foreground": "#d19a66"
        },
        "memberOperatorOverload": {
            "foreground": "#c678dd"
        },
        "parameter.label:dart": {
            "foreground": "#d1cdcd"
        },
        "property:dart": {
            "foreground": "#d19a66"
        },
        "tomlArrayKey": {
            "foreground": "#10D1F4"
        },
